// A minimal window for wiring the platform layer (the real screens come from rs/ui). Colors come from Rust (the system theme), never hardcoded here.
import { Button, ScrollView } from "std-widgets.slint";

export global Pal {
    in property <color> background: #1b1a19;
    in property <color> card: #232120;
    in property <color> line: #3a3735;
    in property <color> text: #ece7e1;
    in property <color> muted: #a39c94;
    in property <color> accent: #f0643c;
    in property <color> on-accent: #ffffff;
    in property <color> error: #e5484d;
}

component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();
    min-height: 32px; min-width: 64px; border-radius: self.height / 2;
    background: ta.pressed ? (root.primary ? Pal.accent.darker(0.15) : Pal.line) : ta.has-hover ? (root.primary ? Pal.accent.brighter(0.1) : Pal.line.brighter(0.1)) : (root.primary ? Pal.accent : Pal.card);
    border-width: root.primary ? 0px : 1px; border-color: Pal.line;
    animate background { duration: 120ms; easing: ease-out; }
    Text { text: root.label; color: root.primary ? Pal.on-accent : Pal.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Bar inherits Rectangle {
    in property <float> value;   // 0..100
    height: 8px; border-radius: 4px; background: Pal.line;
    Rectangle { x: 0; width: parent.width * min(max(root.value, 0), 100) / 100; height: parent.height; border-radius: 4px; background: root.value >= 90 ? Pal.error : Pal.accent; }
}

export struct Row { title: string, sub: string }

export component MainWindow inherits Window {
    title: "Hearth";
    icon: @image-url("../assets/icon.png");
    min-width: 520px; min-height: 420px; preferred-width: 760px; preferred-height: 560px;
    background: Pal.background;
    in property <string> version;
    in property <string> session-text: "No usage yet";
    in property <float> session-pct;
    in property <string> week-text;
    in property <float> week-pct;
    in property <string> status;
    in property <string> update-text;
    in property <bool> ring-me;
    in property <bool> autostart;
    in property <[Row]> computers;
    in property <[Row]> events;
    in property <string> drop-hint;
    callback refresh(); callback test-notify(); callback toggle-ring(bool); callback toggle-autostart(bool); callback run-update(); callback pick-file(); callback quit();
    callback focus-changed(bool);
    VerticalLayout {
        padding: 16px; spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Hearth"; color: Pal.text; font-size: 18px; font-weight: 700; vertical-alignment: center; }
            Text { text: root.version; color: Pal.muted; font-size: 11px; vertical-alignment: center; }
            Rectangle { }
            Pill { label: "Refresh"; clicked => { root.refresh(); } }
            Pill { label: "Test notification"; clicked => { root.test-notify(); } }
            Pill { label: "Attach file"; clicked => { root.pick-file(); } }
        }
        Rectangle {
            background: Pal.card; border-radius: 16px; min-height: 96px;
            VerticalLayout {
                padding: 16px; spacing: 8px;
                Text { text: "Session (5h)  " + root.session-text; color: Pal.text; font-size: 13px; wrap: word-wrap; }
                Bar { value: root.session-pct; }
                Text { text: "Weekly  " + root.week-text; color: Pal.text; font-size: 13px; wrap: word-wrap; }
                Bar { value: root.week-pct; }
            }
        }
        if root.update-text != "": Rectangle {
            background: Pal.accent; border-radius: 16px; min-height: 40px;
            HorizontalLayout { padding: 8px; padding-left: 16px; spacing: 8px;
                Text { text: root.update-text; color: Pal.on-accent; font-size: 13px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                Pill { label: "Update"; primary: false; clicked => { root.run-update(); } }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                background: Pal.card; border-radius: 16px;
                VerticalLayout { padding: 16px; spacing: 6px;
                    Text { text: "Computers"; color: Pal.muted; font-size: 11px; font-weight: 600; }
                    if root.computers.length == 0: Text { text: "No computers yet."; color: Pal.muted; font-size: 12px; }
                    for c in root.computers: VerticalLayout {
                        Text { text: c.title; color: Pal.text; font-size: 13px; font-weight: 500; wrap: word-wrap; }
                        Text { text: c.sub; color: Pal.muted; font-size: 11px; wrap: word-wrap; }
                    }
                    Rectangle { }
                }
            }
            Rectangle {
                background: Pal.card; border-radius: 16px;
                VerticalLayout { padding: 16px; spacing: 6px;
                    Text { text: "Happening"; color: Pal.muted; font-size: 11px; font-weight: 600; }
                    if root.events.length == 0: Text { text: "Nothing yet. Claude's news shows up here."; color: Pal.muted; font-size: 12px; wrap: word-wrap; }
                    ScrollView {
                        VerticalLayout { spacing: 6px;
                            for e in root.events: VerticalLayout {
                                Text { text: e.title; color: Pal.text; font-size: 13px; font-weight: 500; wrap: word-wrap; }
                                Text { text: e.sub; color: Pal.muted; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Pill { label: root.ring-me ? "Ringing: on" : "Ringing: off"; primary: root.ring-me; clicked => { root.toggle-ring(!root.ring-me); } }
            Pill { label: root.autostart ? "Starts with computer: on" : "Starts with computer: off"; primary: root.autostart; clicked => { root.toggle-autostart(!root.autostart); } }
            Text { text: root.drop-hint; color: Pal.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
            Text { text: root.status; color: Pal.muted; font-size: 11px; vertical-alignment: center; }
            Pill { label: "Quit"; clicked => { root.quit(); } }
        }
    }
}

// The small window on top of everything: a call, a permission, a question, a support mail, a friend's request.
export component PopupWindow inherits Window {
    title: "Hearth";
    no-frame: true; always-on-top: true;
    background: Pal.background;
    in property <string> heading;
    in property <string> body;
    in property <string> kind;
    in property <bool> permission;
    in property <bool> own;
    callback action(string);
    Rectangle {
        border-radius: 16px; border-width: 1px; border-color: Pal.line; background: Pal.card;
        VerticalLayout {
            padding: 16px; spacing: 8px;
            Text { text: root.heading; color: Pal.text; font-size: 18px; font-weight: 700; wrap: word-wrap; }
            Text { text: root.body; color: Pal.muted; font-size: 13px; wrap: word-wrap; vertical-stretch: 1; overflow: elide; }
            HorizontalLayout {
                spacing: 8px; alignment: end;
                if root.kind == "support": Pill { label: "Reply with Claude"; primary: true; clicked => { root.action("claude"); } }
                if root.kind == "support": Pill { label: "Ignore"; clicked => { root.action("ignore"); } }
                if root.kind != "support" && root.permission: Pill { label: root.own ? "Allow" : "Allow"; primary: true; clicked => { root.action("allow"); } }
                if root.kind != "support" && root.permission: Pill { label: "Deny"; clicked => { root.action("deny"); } }
                if root.kind != "support" && !root.permission: Pill { label: "Talk"; primary: true; clicked => { root.action("talk"); } }
                if root.kind != "support" && !root.permission: Pill { label: "Open chat"; clicked => { root.action("chat"); } }
                Pill { label: "Dismiss"; clicked => { root.action("dismiss"); } }
            }
        }
    }
}
