import { Palette, Type, Space, Shape, Motion } from "theme.slint";
import { Icon, Tap, UsageRing, Cookie } from "components.slint";

export struct WatchChat { title: string, sub: string, working: bool }

// Round Wear OS layout. The black corners show the circular display.
export component WatchApp inherits Window {
    default-font-family: Type.family;
    background: #000000;
    preferred-width: 400px;
    preferred-height: 400px;
    in-out property <string> screen: "home"; // home | chats
    in property <float> session-pct: 42;
    in property <string> session-reset: "Resets in 1h 59m";
    in property <string> week-line: "Week 63% · Under pace";
    in property <[WatchChat]> chats: [
        { title: "Fix the login bug", sub: "working now", working: true },
        { title: "Plan the trip to Lisbon", sub: "1h" },
        { title: "Release notes 1.4", sub: "1d" },
    ];
    callback open-chat(int);
    callback refresh();           // tap the usage ring
    callback open-chats();        // tap the reset line (screen switches to chats)
    callback back();              // leave the chat list (screen switches to home)
    Rectangle {
        width: min(root.width, root.height);
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Palette.bg;
        clip: true;
        if root.screen == "home": VerticalLayout {
            padding-top: 30px;
            padding-bottom: 36px;
            spacing: 6px;
            alignment: center;
            Text { text: "Session"; color: Palette.muted; font-size: Type.body; horizontal-alignment: center; }
            HorizontalLayout { alignment: center; Tap { width: 190px; height: 190px; border-radius: 95px; UsageRing { width: 190px; height: 190px; pct: root.session-pct; } clicked => { root.refresh(); } } }
            Tap { height: 22px; Text { text: root.session-reset; color: Palette.text; font-size: Type.body; horizontal-alignment: center; } clicked => { root.screen = "chats"; root.open-chats(); } }
            Text { text: root.week-line; color: Palette.faint; font-size: Type.small; horizontal-alignment: center; }
        }
        if root.screen == "chats": VerticalLayout {
            padding-top: 40px;
            padding-left: 62px;
            padding-right: 62px;
            spacing: 8px;
            alignment: start;
            Tap { height: 28px; Text { text: "Chats"; color: Palette.text; font-size: Type.lead; font-weight: 500; horizontal-alignment: center; } clicked => { root.screen = "home"; root.back(); } }
            for r[i] in root.chats: Tap {
                height: 54px;
                border-radius: 27px;
                background: r.working ? Palette.selected : Palette.card-high;
                VerticalLayout {
                    alignment: center;
                    padding-left: 22px;
                    padding-right: 18px;
                    Text { text: r.title; color: r.working ? Palette.on-selected : Palette.text; font-size: Type.body; font-weight: 600; overflow: elide; }
                    Text { text: r.sub; color: Palette.muted; font-size: Type.caption; }
                }
                clicked => { root.open-chat(i); }
            }
        }
    }
}
