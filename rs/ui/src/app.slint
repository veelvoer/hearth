import { Palette, Type, Space, Shape, Motion } from "theme.slint";
import { Icon, Dock } from "components.slint";
import { ChatRow, Msg, ChatList, ChatPane } from "chat.slint";
import { OnboardingScreen, PairingScreen, PermissionPrompt, CallScreen } from "flows.slint";
import { HomeScreen, HistoryScreen, SettingsScreen, Tile, NavItem, Device, Usage, SettingsState } from "pages.slint";
export { Palette, Motion, Type }
export { ChatRow, Msg, Tile, NavItem, Device, Usage, SettingsState }
export { WatchChat } from "watch.slint";
export { WatchApp } from "watch.slint";

// One window for phone and desktop. Width >= 820 px gives the wide layout:
// list left, chat right, compact dock at the foot of the list. Narrower is one pane with the floating dock.
export component App inherits Window {
    default-font-family: Type.family;
    default-font-size: Type.body;
    background: Palette.bg;
    preferred-width: 360px;
    preferred-height: 800px;
    in-out property <string> screen: "chats";   // chats | chat | home | history | settings | onboarding | pairing | call
    in-out property <string> page: "";          // settings page ("" = list on phone, devices on wide)
    in property <bool> chat-top: false;
    in-out property <bool> prompt: false;
    in-out property <bool> update: true;
    in property <string> status: "Server online";

    // ---- chat pane
    in property <string> chat-title: "Fix the login bug on the settings page";
    in property <string> chat-sub: "webshop · Sonnet 5.5 · VPS · working now";
    in property <bool> chat-working: true;
    in-out property <string> draft;
    // ---- lists
    in property <string> filter: "All chats";
    in-out property <string> chat-search;
    in-out property <string> history-search;
    in-out property <string> settings-search;
    // ---- home / usage
    in property <Usage> usage: {
        greeting: "Good evening", date-line: "Monday, November 16 · Claude Max", updated: "Usage updated just now",
        session-pct: 42, session-reset: "Resets in 1h 59m", session-at: "01:58 AM", session-pace: "Under pace", session-note: "~69% by reset",
        week-pct: 63, week-reset: "Resets in 2d 23h", week-at: "Thu 11:58 PM", week-pace: "Ahead of pace", week-note: "Limit in 2d 8h",
        opus-pct: 21, sonnet-pct: 48, range: "30d", scope: "This computer only",
    };
    // ---- update card
    in property <string> update-version: "1.41.0";
    in property <string> update-notes: "Faster chat opening and smoother motion.";
    // ---- permission prompt
    in property <string> prompt-tool: "Edit";
    in property <string> prompt-target: "Settings.tsx";
    in property <string> prompt-detail: "Claude wants to change 14 lines in src/Settings.tsx.";
    // ---- call
    in property <string> call-time: "02:14";
    in property <string> call-state: "Listening";
    in-out property <bool> call-muted: false;
    // ---- pairing / onboarding
    in-out property <string> pair-link;
    in property <string> pair-error;
    in-out property <int> onboarding-step: 0;
    // ---- settings values
    in-out property <SettingsState> settings: {
        theme: "dark", motion: true, frosted: true, expressive: true,
        notify-finished: true, notify-usage: true, auto-update: true, install-on-quit: false,
        run-on-server: true, keep-copy: true, ask-edit: true, ask-cmd: true,
    };

    // ---- actions (the app implements these; the screens never need to be reached into)
    callback new-chat();
    callback open-chat(int);          // index in `chats` (or `history` via open-history)
    callback open-history(int);       // index in `history`
    callback send(string);            // composer text, already cleared in the UI
    callback stop();                  // Stop beside Send
    callback composer-option(string); // "edits" | "model" | "effort"
    callback send-now(int);           // queued message at index in `messages`
    callback remove-queued(int);      // same index
    callback show-earlier();
    callback pin-chat(int);
    callback delete-chat(int);
    callback rename-chat(int);        // double click on a row
    callback chat-search-edited(string);
    callback history-search-edited(string);
    callback settings-search-edited(string);
    callback filter-clicked();        // project filter pill
    callback list-menu();             // dots in the chat list header
    callback chat-menu();             // dots / sidebar in the chat header
    callback mic();                   // mic in chat header or home (start a call: set screen "call")
    callback refresh-usage();
    callback usage-range-picked(string); // "7d" | "30d" | "all"
    callback tab-changed(int);        // 0 chats, 1 home, 2 history, 3 settings (screen already switched)
    callback page-picked(string);     // settings page id (page already set)
    callback setting-toggled(string, bool); // id = SettingsState field name; `settings` already updated
    callback theme-picked(string);    // "system" | "dark" | "light"
    callback device-remove(int);
    callback device-add();
    callback device-refresh();
    callback routine-new();
    callback update-install();
    callback update-later();
    callback prompt-answered(string); // "allow-once" | "allow-always" | "deny" (prompt already closed)
    callback pair-connect(string);
    callback pair-scan();
    callback onboarding-finish();
    callback onboarding-skip();
    callback call-hangup();
    callback call-mute(bool);
    property <bool> wide: self.width >= 820px;
    property <bool> split: root.wide && (root.screen == "chats" || root.screen == "chat");
    property <int> tab: root.screen == "home" ? 1 : root.screen == "history" ? 2 : root.screen == "settings" ? 3 : 0;
    in-out property <[ChatRow]> chats: [
        { header: "Working now", title: "Fix the login bug on the settings page", sub: "webshop · working now", working: true, selected: true },
        { header: "Today", title: "Plan the trip to Lisbon", sub: "Talk · 1h", swiped: false },
        { header: "Yesterday", title: "Write release notes for 1.4", sub: "hearth · 1d", pinned: true },
        { header: "Previous 7 days", title: "Why is the build slow?", sub: "api · 3d" },
        { title: "Summarize the invoices", sub: "Talk · 5d" },
    ];
    in-out property <[ChatRow]> history: [
        { header: "Today", title: "Plan the trip to Lisbon", sub: "Talk · 1h" },
        { title: "Fix the login bug on the settings page", sub: "webshop · 2h" },
        { header: "Yesterday", title: "Write release notes for 1.4", sub: "hearth · 1d" },
        { header: "Previous 7 days", title: "Why is the build slow?", sub: "api · 3d" },
        { title: "Summarize the invoices", sub: "Talk · 5d" },
        { title: "Rename the staging bucket", sub: "infra · 6d" },
    ];
    in-out property <[Msg]> messages: [
        { kind: "earlier" },
        { kind: "user", text: "The settings form loses what I typed when I switch tabs. Can you fix it?" },
        { kind: "text", text: "I'll look at how the form keeps its state." },
        { kind: "heading", text: "What I found" },
        { kind: "text", text: "The tabs unmount the form, so the draft is lost. I'll keep the draft in the parent and restore it when the tab opens again." },
        { kind: "code", lead: "TYPESCRIPT", text: "const [draft, setDraft] = useState(saved);\nuseEffect(() => save(draft), [draft]);" },
        { kind: "time", text: "11:50 PM" },
        { kind: "tool", lead: "Read", text: "LoginForm.tsx", time: "11:50 PM", status: "done" },
        { kind: "tool", lead: "Edit", text: "Settings.tsx", time: "11:51 PM", status: "applied" },
        { kind: "text", text: "Done. The form now keeps its draft when you switch tabs." },
        { kind: "bullet", lead: "Settings.tsx", text: "holds the draft" },
        { kind: "bullet", lead: "LoginForm.tsx", text: "reads it on mount" },
        { kind: "quote", text: "Drafts are cleared after a successful save." },
        { kind: "text", text: "Want me to add a test?" },
        { kind: "time", text: "11:52 PM" },
        { kind: "meta", text: "1.2k output · 18k input · 41s" },
        { kind: "queued", text: "Also run the linter once you are done." },
        { kind: "working" },
    ];
    in-out property <[Tile]> tiles: [
        { label: "API value", value: "$38.20", sub: "what it would cost per token" },
        { label: "Tokens used", value: "2.1M", sub: "640k written · 1.5M read fresh" },
        { label: "Cached reads", value: "9.0M", sub: "saved about $61.00" },
        { label: "Sessions", value: "41", sub: "19 active days" },
        { label: "Messages", value: "912", sub: "" },
        { label: "Longest streak", value: "9 days", sub: "" },
        { label: "Favourite model", value: "Sonnet 5.5", sub: "" },
        { label: "Longest session", value: "2h 0m", sub: "" },
    ];
    in-out property <[NavItem]> nav: [
        { header: "Connection", id: "devices", label: "Devices", icon: "devices" },
        { id: "updates", label: "Updates", icon: "sync" },
        { header: "App", id: "notifications", label: "Notifications", icon: "bell" },
        { id: "appearance", label: "Appearance", icon: "palette" },
        { header: "Server", id: "routines", label: "Routines", icon: "clock" },
        { id: "server", label: "Server", icon: "server" },
        { id: "keys", label: "Keys and permissions", icon: "key" },
        { header: "More", id: "help", label: "Help", icon: "lifebuoy" },
        { id: "about", label: "About", icon: "info" },
    ];
    in-out property <[Device]> devices: [
        { name: "laptop (this computer)", sub: "This computer" },
        { name: "VPS", sub: "Server · hearth.example.com", removable: true },
    ];

    function go(i: int) {
        root.page = "";
        root.screen = i == 0 ? "chats" : i == 1 ? "home" : i == 2 ? "history" : "settings";
        root.tab-changed(i);
    }
    function set-setting(id: string, v: bool) {
        if id == "motion" { root.settings.motion = v; }
        if id == "frosted" { root.settings.frosted = v; }
        if id == "expressive" { root.settings.expressive = v; }
        if id == "notify-finished" { root.settings.notify-finished = v; }
        if id == "notify-usage" { root.settings.notify-usage = v; }
        if id == "auto-update" { root.settings.auto-update = v; }
        if id == "install-on-quit" { root.settings.install-on-quit = v; }
        if id == "run-on-server" { root.settings.run-on-server = v; }
        if id == "keep-copy" { root.settings.keep-copy = v; }
        if id == "ask-edit" { root.settings.ask-edit = v; }
        if id == "ask-cmd" { root.settings.ask-cmd = v; }
        root.setting-toggled(id, v);
    }

    if root.split: HorizontalLayout {
        padding: 12px;
        padding-left: 4px;
        spacing: 12px;
        ChatList {
            width: 300px;
            chats: root.chats;
            filter: root.filter;
            search <=> root.chat-search;
            open(i) => { root.screen = "chat"; root.open-chat(i); }
            pin(i) => { root.pin-chat(i); }
            delete(i) => { root.delete-chat(i); }
            rename(i) => { root.rename-chat(i); }
            search-edited(t) => { root.chat-search-edited(t); }
            filter-clicked => { root.filter-clicked(); }
            menu => { root.list-menu(); }
        }
        ChatPane {
            title: root.chat-title;
            sub: root.chat-sub;
            working: root.chat-working;
            messages: root.messages;
            top: root.chat-top;
            draft <=> root.draft;
            send(t) => { root.send(t); }
            stop => { root.stop(); }
            option(o) => { root.composer-option(o); }
            send-now(i) => { root.send-now(i); }
            remove-queued(i) => { root.remove-queued(i); }
            show-earlier => { root.show-earlier(); }
            mic => { root.mic(); }
            menu => { root.chat-menu(); }
        }
    }
    if !root.wide && root.screen == "chats": ChatList {
        chats: root.chats;
        filter: root.filter;
        search <=> root.chat-search;
        open(i) => { root.screen = "chat"; root.open-chat(i); }
        pin(i) => { root.pin-chat(i); }
        delete(i) => { root.delete-chat(i); }
        rename(i) => { root.rename-chat(i); }
        search-edited(t) => { root.chat-search-edited(t); }
        filter-clicked => { root.filter-clicked(); }
        menu => { root.list-menu(); }
    }
    if !root.wide && root.screen == "chat": ChatPane {
        border-radius: 0px;
        show-back: true;
        narrow: true;
        top: root.chat-top;
        title: root.chat-title;
        sub: root.chat-sub;
        working: root.chat-working;
        messages: root.messages;
        draft <=> root.draft;
        back => { root.screen = "chats"; }
        send(t) => { root.send(t); }
        stop => { root.stop(); }
        option(o) => { root.composer-option(o); }
        send-now(i) => { root.send-now(i); }
        remove-queued(i) => { root.remove-queued(i); }
        show-earlier => { root.show-earlier(); }
        mic => { root.mic(); }
        menu => { root.chat-menu(); }
    }
    if root.screen == "home": HomeScreen {
        wide: root.wide;
        tiles: root.tiles;
        usage: root.usage;
        update: root.update;
        update-version: root.update-version;
        update-notes: root.update-notes;
        dismiss-update => { root.update = false; root.update-later(); }
        install-update => { root.update-install(); }
        refresh => { root.refresh-usage(); }
        mic => { root.mic(); }
        range-picked(r) => { root.usage-range-picked(r); }
    }
    if root.screen == "history": HistoryScreen {
        items: root.history;
        wide: root.wide;
        search <=> root.history-search;
        open(i) => { root.open-history(i); }
        search-edited(t) => { root.history-search-edited(t); }
    }
    if root.screen == "settings": SettingsScreen {
        wide: root.wide;
        page: root.page;
        items: root.nav;
        devices: root.devices;
        st: root.settings;
        update-version: root.update-version;
        update-notes: root.update-notes;
        search <=> root.settings-search;
        pick(id) => { root.page = id; root.page-picked(id); }
        back => { root.page = ""; }
        search-edited(t) => { root.settings-search-edited(t); }
        toggled(id, v) => { root.set-setting(id, v); }
        theme(t) => { root.settings.theme = t; root.theme-picked(t); }
        device-remove(d) => { root.device-remove(d); }
        device-add => { root.device-add(); }
        device-refresh => { root.device-refresh(); }
        update-install => { root.update-install(); }
        update-later => { root.update-later(); }
        routine-new => { root.routine-new(); }
    }
    if root.screen == "onboarding": OnboardingScreen {
        step <=> root.onboarding-step;
        finish => { root.screen = "pairing"; root.onboarding-finish(); }
        skip => { root.screen = "chats"; root.onboarding-skip(); }
    }
    if root.screen == "pairing": PairingScreen {
        link <=> root.pair-link;
        error: root.pair-error;
        connect(l) => { root.pair-connect(l); }
        scan => { root.pair-scan(); }
        back => { root.screen = "settings"; }
    }
    if root.screen == "call": CallScreen {
        time: root.call-time;
        state: root.call-state;
        muted: root.call-muted;
        mute(m) => { root.call-muted = m; root.call-mute(m); }
        hangup => { root.call-hangup(); root.screen = "chat"; }
    }
    // dock: compact at the foot of the list on wide, floating elsewhere
    if root.split: Dock {
        compact: true;
        x: 16px;
        y: root.height - 48px - 18px;
        width: 276px;
        height: 48px;
        current: 0;
        go(i) => { root.go(i); }
        new-chat => { root.new-chat(); }
    }
    if !root.split && root.screen != "chat" && root.screen != "onboarding" && root.screen != "pairing" && root.screen != "call": Dock {
        x: 0px;
        y: root.height - 64px - 20px;
        width: root.width;
        height: 64px;
        status: root.wide ? root.status : "";
        current: root.tab;
        go(i) => { root.go(i); }
        new-chat => { root.new-chat(); }
    }
    if root.prompt: PermissionPrompt {
        tool: root.prompt-tool;
        target: root.prompt-target;
        detail: root.prompt-detail;
        deny => { root.prompt = false; root.prompt-answered("deny"); }
        allow-once => { root.prompt = false; root.prompt-answered("allow-once"); }
        allow-always => { root.prompt = false; root.prompt-answered("allow-always"); }
    }
}
