// Hearth design tokens. Material 3 Expressive, warm "clay" palette, dark first.
// Every colour in components and screens comes from here (Palette.*), never a literal.
// Oxide / system colours override the in-out accent properties from Rust.

export global Palette {
    in-out property <bool> dark: true;
    // accent overrides (system / Oxide theme); transparent = use the built-in clay
    in-out property <color> accent-override: transparent;

    out property <color> bg: dark ? #1a110f : #fff8f6;
    out property <color> surface-low: dark ? #231917 : #fff1ed;
    out property <color> card: dark ? #271d1b : #fceae5;
    out property <color> card-high: dark ? #322825 : #f6e4df;
    out property <color> card-highest: dark ? #3d3230 : #f0deda;
    out property <color> text: dark ? #f1dfda : #231917;
    out property <color> muted: dark ? #d8c2bb : #53433e;
    out property <color> faint: dark ? #a08d86 : #85736d;
    out property <color> outline: dark ? #a08d86 : #85736d;
    out property <color> outline-soft: dark ? #53433e : #d8c2bb;
    out property <color> accent: accent-override.alpha > 0 ? accent-override : (dark ? #f0643c : #9a4122);
    out property <color> on-accent: dark ? #1b1a19 : #ffffff;
    out property <color> accent-container: dark ? #7c2e0f : #ffdbcf;
    out property <color> on-accent-container: dark ? #ffdbcf : #380d00;
    out property <color> selected: dark ? #5d4036 : #efd0c5;
    out property <color> on-selected: dark ? #ffdbcf : #2c150f;
    out property <color> error: dark ? #ffb4ab : #ba1a1a;
    out property <color> ok: dark ? #5cc58c : #2e7d4f;
    out property <color> scrim: dark ? #000000aa : #00000055;
    // dock glass: a frosted layer that stays readable on any content
    out property <color> dock: dark ? #2a1f1df2 : #efdcd7f2;
}

export global Type {
    out property <length> caption: 11px;
    out property <length> small: 12px;
    out property <length> body: 13px;
    out property <length> read: 14px;
    out property <length> lead: 18px;
    out property <length> display: 28px;
    out property <string> family: "Noto Sans";
    out property <string> mono: "JetBrains Mono";
}

export global Space {
    out property <length> xs: 4px;
    out property <length> s: 6px;
    out property <length> m: 8px;
    out property <length> l: 12px;
    out property <length> xl: 16px;
}

export global Shape {
    out property <length> pill: 999px;
    out property <length> card: 28px;
    out property <length> inner: 16px;
    out property <length> small: 12px;
}

// Motion: one global factor (0 = reduced motion / "Motion" setting off).
// Springs are cubic-bezier curves with overshoot; colour and opacity use the plain ease-out.
export global Motion {
    in-out property <float> scale: 1;
    out property <duration> hover: 120ms * scale;
    out property <duration> fast: 200ms * scale;
    out property <duration> move: 280ms * scale;
    out property <duration> slow: 380ms * scale;
    out property <easing> spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    out property <easing> soft-spring: cubic-bezier(0.25, 1.2, 0.5, 1);
    out property <easing> out: cubic-bezier(0.33, 1, 0.68, 1);
}
