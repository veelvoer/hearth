// First real watch screen of the pipeline: round layout (400x400 reference), usage and chats as plain text.
// Colours come only from the platform palette; the real design system arrives from rs/ui.
import { Button, ListView, Palette } from "std-widgets.slint";

export struct ChatItem { id: string, title: string, busy: bool }

export component WatchWindow inherits Window {
    in property <string> status;
    in property <string> via;
    in property <string> usage;
    in property <string> detail;
    in property <bool> has-server;
    in property <[ChatItem]> chats;
    callback open-chat(string);
    callback refresh();
    callback paste();
    callback close-detail();
    background: Palette.background;

    // a round screen clips the corners: keep content in the inscribed box
    VerticalLayout {
        padding-left: 44px;
        padding-right: 44px;
        padding-top: 40px;
        padding-bottom: 40px;
        spacing: 6px;
        alignment: center;
        if root.detail == "": VerticalLayout {
            spacing: 6px;
            Text { text: root.usage != "" ? root.usage : "Hearth"; font-size: 18px; font-weight: 700; color: Palette.foreground; horizontal-alignment: center; }
            Text { text: root.status != "" ? root.status : root.via; font-size: 11px; color: Palette.foreground; opacity: 0.7; horizontal-alignment: center; wrap: word-wrap; }
            if !root.has-server: Button { text: "Paste link"; primary: true; clicked => { root.paste(); } }
            if root.has-server: ListView {
                height: 170px;
                for c in root.chats: Rectangle {
                    height: 36px;
                    TouchArea { clicked => { root.open-chat(c.id); } }
                    Text { x: 0; width: parent.width; text: (c.busy ? "● " : "") + c.title; font-size: 13px; font-weight: 600; color: Palette.foreground; vertical-alignment: center; overflow: elide; }
                }
            }
            if root.has-server: Button { text: "Refresh"; clicked => { root.refresh(); } }
        }
        if root.detail != "": VerticalLayout {
            spacing: 8px;
            Flickable {
                height: 220px;
                Text { width: parent.width; text: root.detail; font-size: 12px; color: Palette.foreground; wrap: word-wrap; }
            }
            Button { text: "Back"; clicked => { root.close-detail(); } }
        }
    }
}
