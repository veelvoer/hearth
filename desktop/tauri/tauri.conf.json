{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearth",
  "mainBinaryName": "hearth",
  "identifier": "dev.voer.hearth",
  "build": { "frontendDist": "web", "beforeBuildCommand": "node -e \"require('fs').mkdirSync('tauri/web', { recursive: true })\"" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Claude usage, chats, voice and calls",
    "longDescription": "Hearth: Claude Code on your phone and computer.",
    "linux": { "deb": { "depends": [] } },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
